{
  "name": "printhq-ultimaker-modern",
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "homepage": "./",
  "scripts": {
    "start": "node server.js",
    "dev": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "axios": "^1.6.0",
    "basic-ftp": "^6.0.1",
    "better-sqlite3": "^9.6.0",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "jsonwebtoken": "^9.0.0",
    "mqtt": "^5.15.2",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^9.0.3",
    "ping": "^0.4.4",
    "ws": "^8.21.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1",
    "@electron/rebuild": "^3.6.0"
  },
  "build": {
    "appId": "com.sasa.printhq",
    "productName": "PrintNexus",
    "asar": false,
    "icon": "C:\\Users\\tolga.ibis\\Desktop\\3DFarm\\PrintHQ\\assets\\PrintNexus_icon.ico",
    "files": [
      "electron/**/*",
      "server.js",
      "database.js",
      "adapters/**/*",
      "public/**/*",
      "node_modules/**/*",
      "*.db",
      ".env",
      "printers.json"
      
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  }
}